{
  "saffron": {
    "command": "npx",
    "args": [
      "-y",
      "-p",
      "saffron-ai@0.6.0",
      "saffron",
      "lsp"
    ],
    "extensionToLanguage": {
      ".saffron": "saffron",
      ".feature": "saffron"
    },
    "transport": "stdio",
    "workspaceFolder": "${CLAUDE_PROJECT_DIR}",
    "startupTimeout": 120000,
    "restartOnCrash": true,
    "maxRestarts": 3
  }
}
